# Server name shown in the server list
SERVER_NAME=Mi Servidor Minecraft

# Message shown when connecting
MOTD=Servidor Minecraft Crossplay - Java & Bedrock

# Server icon (must be a 64x64 PNG file)
ICON=./data/server-icon.png

# Game mode: survival, creative, adventure, spectator
GAMEMODE=survival

# Difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Maximum number of players
MAX_PLAYERS=20

# Server memory allocation
MEMORY=2G

# Enable online mode (true = only premium accounts for Java players)
ONLINE_MODE=true

# Enable command blocks
ENABLE_COMMAND_BLOCK=true

# World seed (leave empty for random)
SEED=

# Player vs Player
PVP=true

# View distance (chunks)
VIEW_DISTANCE=10

# Whitelist: only listed players can join (true/false)
ENABLE_WHITELIST=false

# Comma separated list of allowed Java players
# NOTE: Bedrock players cannot be added here. Use the Floodgate command instead:
#   docker exec -i minecraft-server rcon-cli
#   fwhitelist add NombreXboxLive
WHITELIST= ExamplePlayer1,ExamplePlayer2

# Backup interval (examples: 2h, 30m, 1d)
BACKUP_INTERVAL=2h

# How many days to keep old backups
PRUNE_BACKUPS_DAYS=7

# Accept Minecraft EULA (must be TRUE to run)
EULA=TRUE

# RCON
# REQUIRED: strong password for RCON remote console
RCON_PASSWORD=

# Postgres (Dashboard DB)
POSTGRES_DB=mcdashboard
POSTGRES_USER=mcadmin
# REQUIRED: strong password for the database
POSTGRES_PASSWORD=

# Dashboard Auth
# REQUIRED: random long string for JWT signing
JWT_SECRET=
# Admin login credentials
ADMIN_USERNAME=admin
# REQUIRED: strong password for dashboard admin
ADMIN_PASSWORD=