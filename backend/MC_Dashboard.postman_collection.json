{
	"info": {
		"name": "MC Dashboard",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('token', json.token);",
									"        console.log('Token saved');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Server",
			"item": [
				{
					"name": "Get Server Status",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "status"]
						}
					}
				}
			]
		},
		{
			"name": "Players",
			"item": [
				{
					"name": "Get All Players",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/players",
							"host": ["{{baseUrl}}"],
							"path": ["api", "players"]
						}
					}
				},
				{
					"name": "Get Player by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/players/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "players", "1"]
						}
					}
				},
				{
					"name": "Get Player Sessions",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/players/1/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "players", "1", "sessions"]
						}
					}
				}
			]
		},
		{
			"name": "Sessions",
			"item": [
				{
					"name": "Get All Sessions",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/sessions?page=0&size=20&sort=joinedAt,desc",
							"host": ["{{baseUrl}}"],
							"path": ["api", "sessions"],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								},
								{
									"key": "sort",
									"value": "joinedAt,desc"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Execute RCON Command",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"command\": \"list\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/command",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "command"]
						}
					}
				},
				{
					"name": "Whitelist Player",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"player\": \"Steve\",\n    \"action\": \"add\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/whitelist",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "whitelist"]
						}
					}
				}
			]
		}
	]
}